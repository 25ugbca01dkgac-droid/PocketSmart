# PocketSmart AI Environment Configuration

# Google Gemini API Key (Get yours from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Recommended Gemini Model: gemini-1.5-flash or gemini-1.5-pro
GEMINI_MODEL=gemini-1.5-flash

# Application Security
SECRET_KEY=pocketsmart_super_secure_secret_key_change_in_production_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server settings
HOST=127.0.0.1
PORT=8000
DEBUG=True
DATABASE_URL=sqlite:///./pocketsmart.db
